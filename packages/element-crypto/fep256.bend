          +c6 = (t6 / 8192 : U32)
          +t7 = ((a7 + b7 : U32) + c6 : U32)
          +c7 = (t7 / 8192 : U32)
          +t8 = ((a8 + b8 : U32) + c7 : U32)
          +c8 = (t8 / 8192 : U32)
          +t9 = ((a9 + b9 : U32) + c8 : U32)
          +c9 = (t9 / 8192 : U32)
          +t10 = ((a10 + b10 : U32) + c9 : U32)
          +c10 = (t10 / 8192 : U32)
          +t11 = ((a11 + b11 : U32) + c10 : U32)
          +c11 = (t11 / 8192 : U32)
          +t12 = ((a12 + b12 : U32) + c11 : U32)
          +c12 = (t12 / 8192 : U32)
          +t13 = ((a13 + b13 : U32) + c12 : U32)
          +c13 = (t13 / 8192 : U32)
