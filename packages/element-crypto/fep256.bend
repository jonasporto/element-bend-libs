          +t18 = ((a18 + b18 : U32) + c17 : U32)
          +c18 = (t18 / 8192 : U32)
          +t19 = ((a19 + b19 : U32) + c18 : U32)
          less_2p(Fe{U32.and(t0, 8191), U32.and(t1, 8191), U32.and(t2, 8191), U32.and(t3, 8191), U32.and(t4, 8191), U32.and(t5, 8191), U32.and(t6, 8191), U32.and(t7, 8191), U32.and(t8, 8191), U32.and(t9, 8191), U32.and(t10, 8191), U32.and(t11, 8191), U32.and(t12, 8191), U32.and(t13, 8191), U32.and(t14, 8191), U32.and(t15, 8191), U32.and(t16, 8191), U32.and(t17, 8191), U32.and(t18, 8191), t19})

# a - b: a borrow chain, then 2p added by a mask when it borrowed (a - b + 2p is in
# (0, 2p) then); the carry out of the top limb is the R the borrow lent.
def sub(a: Fe, b: Fe) -> Fe:
  match a:
    case Fe{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14, +a15, +a16, +a17, +a18, +a19}:
