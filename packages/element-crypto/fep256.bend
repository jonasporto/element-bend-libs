      +w4 = (1 - (y4 / 8192 : U32) : U32)
      +y5 = (((x5 + 8192 : U32) - 8191 : U32) - w4 : U32)
      +w5 = (1 - (y5 / 8192 : U32) : U32)
      +y6 = (((x6 + 8192 : U32) - 8191 : U32) - w5 : U32)
      +w6 = (1 - (y6 / 8192 : U32) : U32)
      +y7 = (((x7 + 8192 : U32) - 63 : U32) - w6 : U32)
      +w7 = (1 - (y7 / 8192 : U32) : U32)
      +y8 = (((x8 + 8192 : U32) - 0 : U32) - w7 : U32)
      +w8 = (1 - (y8 / 8192 : U32) : U32)
      +y9 = (((x9 + 8192 : U32) - 0 : U32) - w8 : U32)
      +w9 = (1 - (y9 / 8192 : U32) : U32)
      +y10 = (((x10 + 8192 : U32) - 0 : U32) - w9 : U32)
      +w10 = (1 - (y10 / 8192 : U32) : U32)
      +y11 = (((x11 + 8192 : U32) - 0 : U32) - w10 : U32)
      +w11 = (1 - (y11 / 8192 : U32) : U32)
      +y12 = (((x12 + 8192 : U32) - 0 : U32) - w11 : U32)
      +w12 = (1 - (y12 / 8192 : U32) : U32)
      +y13 = (((x13 + 8192 : U32) - 0 : U32) - w12 : U32)
      +w13 = (1 - (y13 / 8192 : U32) : U32)
      +y14 = (((x14 + 8192 : U32) - 2048 : U32) - w13 : U32)
      +w14 = (1 - (y14 / 8192 : U32) : U32)
      +y15 = (((x15 + 8192 : U32) - 0 : U32) - w14 : U32)
      +w15 = (1 - (y15 / 8192 : U32) : U32)
      +y16 = (((x16 + 8192 : U32) - 0 : U32) - w15 : U32)
      +w16 = (1 - (y16 / 8192 : U32) : U32)
      +y17 = (((x17 + 8192 : U32) - 8176 : U32) - w16 : U32)
      +w17 = (1 - (y17 / 8192 : U32) : U32)
      +y18 = (((x18 + 8192 : U32) - 8191 : U32) - w17 : U32)
      +w18 = (1 - (y18 / 8192 : U32) : U32)
      +y19 = (((x19 + 8192 : U32) - 1023 : U32) - w18 : U32)
      +w19 = (1 - (y19 / 8192 : U32) : U32)
      +m = (w19 - 1 : U32)
      Fe{U32.xor(x0, U32.and(m, U32.xor(x0, U32.and(y0, 8191)))), U32.xor(x1, U32.and(m, U32.xor(x1, U32.and(y1, 8191)))), U32.xor(x2, U32.and(m, U32.xor(x2, U32.and(y2, 8191)))), U32.xor(x3, U32.and(m, U32.xor(x3, U32.and(y3, 8191)))), U32.xor(x4, U32.and(m, U32.xor(x4, U32.and(y4, 8191)))), U32.xor(x5, U32.and(m, U32.xor(x5, U32.and(y5, 8191)))), U32.xor(x6, U32.and(m, U32.xor(x6, U32.and(y6, 8191)))), U32.xor(x7, U32.and(m, U32.xor(x7, U32.and(y7, 8191)))), U32.xor(x8, U32.and(m, U32.xor(x8, U32.and(y8, 8191)))), U32.xor(x9, U32.and(m, U32.xor(x9, U32.and(y9, 8191)))), U32.xor(x10, U32.and(m, U32.xor(x10, U32.and(y10, 8191)))), U32.xor(x11, U32.and(m, U32.xor(x11, U32.and(y11, 8191)))), U32.xor(x12, U32.and(m, U32.xor(x12, U32.and(y12, 8191)))), U32.xor(x13, U32.and(m, U32.xor(x13, U32.and(y13, 8191)))), U32.xor(x14, U32.and(m, U32.xor(x14, U32.and(y14, 8191)))), U32.xor(x15, U32.and(m, U32.xor(x15, U32.and(y15, 8191)))), U32.xor(x16, U32.and(m, U32.xor(x16, U32.and(y16, 8191)))), U32.xor(x17, U32.and(m, U32.xor(x17, U32.and(y17, 8191)))), U32.xor(x18, U32.and(m, U32.xor(x18, U32.and(y18, 8191)))), U32.xor(x19, U32.and(m, U32.xor(x19, U32.and(y19, 8191))))}

# x below 2p to its canonical value in [0, p): p subtracted by a mask.
