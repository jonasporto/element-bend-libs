# Swap-free select: a when s is 0, b when s is 1 (a mask, no branch).
def select(+s: U32, a: Fe, b: Fe) -> Fe:
  match a:
    case Fe{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14, +a15, +a16, +a17, +a18, +a19}:
      match b:
        case Fe{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7, +b8, +b9, +b10, +b11, +b12, +b13, +b14, +b15, +b16, +b17, +b18, +b19}:
          +m = (0 - s : U32)
          Fe{U32.xor(a0, U32.and(m, U32.xor(a0, b0))), U32.xor(a1, U32.and(m, U32.xor(a1, b1))), U32.xor(a2, U32.and(m, U32.xor(a2, b2))), U32.xor(a3, U32.and(m, U32.xor(a3, b3))), U32.xor(a4, U32.and(m, U32.xor(a4, b4))), U32.xor(a5, U32.and(m, U32.xor(a5, b5))), U32.xor(a6, U32.and(m, U32.xor(a6, b6))), U32.xor(a7, U32.and(m, U32.xor(a7, b7))), U32.xor(a8, U32.and(m, U32.xor(a8, b8))), U32.xor(a9, U32.and(m, U32.xor(a9, b9))), U32.xor(a10, U32.and(m, U32.xor(a10, b10))), U32.xor(a11, U32.and(m, U32.xor(a11, b11))), U32.xor(a12, U32.and(m, U32.xor(a12, b12))), U32.xor(a13, U32.and(m, U32.xor(a13, b13))), U32.xor(a14, U32.and(m, U32.xor(a14, b14))), U32.xor(a15, U32.and(m, U32.xor(a15, b15))), U32.xor(a16, U32.and(m, U32.xor(a16, b16))), U32.xor(a17, U32.and(m, U32.xor(a17, b17))), U32.xor(a18, U32.and(m, U32.xor(a18, b18))), U32.xor(a19, U32.and(m, U32.xor(a19, b19)))}

def or_limbs(x: Fe) -> U32:
  match x:
    case Fe{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15, +x16, +x17, +x18, +x19}:
      U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(U32.or(x0, x1), x2), x3), x4), x5), x6), x7), x8), x9), x10), x11), x12), x13), x14), x15), x16), x17), x18), x19)

def is_zero(+x: Fe) -> Bool:
  U32.is_zero(or_limbs(canon(x)))

def eq(+a: Fe, +b: Fe) -> Bool:
  is_zero(sub(a, b))

def to_mont(+x: Fe) -> Fe:
  mul(x, r2())

# Out of Montgomery form, canonical.
def from_mont(+x: Fe) -> Fe:
  canon(mul(x, unit()))

def or0(m: Maybe<&2, U32>) -> U32:
  match m:
    case None{}:
      0
    case Some{v}:
      v

def byte_at(xs: List<&2, U32>, +n: Nat) -> U32:
  or0(List.get(&2, U32, xs, n))

# The plain value of big-endian bytes; only the last 32 count (callers check
# the length), so the value is below 2^256. Not reduced: see is_reduced.
def of_bytes(+bs: List<&2, U32>) -> Fe:
  +le = List.reverse(&2, U32, bs)
  +b0 = byte_at(le, 0n)
  +b1 = byte_at(le, 1n)
  +b2 = byte_at(le, 2n)
  +b3 = byte_at(le, 3n)
  +b4 = byte_at(le, 4n)
  +b5 = byte_at(le, 5n)
  +b6 = byte_at(le, 6n)
  +b7 = byte_at(le, 7n)
  +b8 = byte_at(le, 8n)
  +b9 = byte_at(le, 9n)
  +b10 = byte_at(le, 10n)
  +b11 = byte_at(le, 11n)
  +b12 = byte_at(le, 12n)
  +b13 = byte_at(le, 13n)
  +b14 = byte_at(le, 14n)
  +b15 = byte_at(le, 15n)
  +b16 = byte_at(le, 16n)
  +b17 = byte_at(le, 17n)
  +b18 = byte_at(le, 18n)
  +b19 = byte_at(le, 19n)
  +b20 = byte_at(le, 20n)
  +b21 = byte_at(le, 21n)
  +b22 = byte_at(le, 22n)
  +b23 = byte_at(le, 23n)
  +b24 = byte_at(le, 24n)
  +b25 = byte_at(le, 25n)
  +b26 = byte_at(le, 26n)
  +b27 = byte_at(le, 27n)
  +b28 = byte_at(le, 28n)
  +b29 = byte_at(le, 29n)
  +b30 = byte_at(le, 30n)
  +b31 = byte_at(le, 31n)
  +m0 = U32.and(((b0 * 1 : U32) + (b1 * 256 : U32) : U32), 8191)
  +m1 = U32.and((((b1 / 32 : U32) + (b2 * 8 : U32) : U32) + (b3 * 2048 : U32) : U32), 8191)
  +m2 = U32.and(((b3 / 4 : U32) + (b4 * 64 : U32) : U32), 8191)
  +m3 = U32.and((((b4 / 128 : U32) + (b5 * 2 : U32) : U32) + (b6 * 512 : U32) : U32), 8191)
  +m4 = U32.and((((b6 / 16 : U32) + (b7 * 16 : U32) : U32) + (b8 * 4096 : U32) : U32), 8191)
  +m5 = U32.and(((b8 / 2 : U32) + (b9 * 128 : U32) : U32), 8191)
  +m6 = U32.and((((b9 / 64 : U32) + (b10 * 4 : U32) : U32) + (b11 * 1024 : U32) : U32), 8191)
  +m7 = U32.and(((b11 / 8 : U32) + (b12 * 32 : U32) : U32), 8191)
  +m8 = U32.and(((b13 * 1 : U32) + (b14 * 256 : U32) : U32), 8191)
  +m9 = U32.and((((b14 / 32 : U32) + (b15 * 8 : U32) : U32) + (b16 * 2048 : U32) : U32), 8191)
  +m10 = U32.and(((b16 / 4 : U32) + (b17 * 64 : U32) : U32), 8191)
  +m11 = U32.and((((b17 / 128 : U32) + (b18 * 2 : U32) : U32) + (b19 * 512 : U32) : U32), 8191)
  +m12 = U32.and((((b19 / 16 : U32) + (b20 * 16 : U32) : U32) + (b21 * 4096 : U32) : U32), 8191)
  +m13 = U32.and(((b21 / 2 : U32) + (b22 * 128 : U32) : U32), 8191)
  +m14 = U32.and((((b22 / 64 : U32) + (b23 * 4 : U32) : U32) + (b24 * 1024 : U32) : U32), 8191)
  +m15 = U32.and(((b24 / 8 : U32) + (b25 * 32 : U32) : U32), 8191)
  +m16 = U32.and(((b26 * 1 : U32) + (b27 * 256 : U32) : U32), 8191)
  +m17 = U32.and((((b27 / 32 : U32) + (b28 * 8 : U32) : U32) + (b29 * 2048 : U32) : U32), 8191)
  +m18 = U32.and(((b29 / 4 : U32) + (b30 * 64 : U32) : U32), 8191)
  +m19 = U32.and(((b30 / 128 : U32) + (b31 * 2 : U32) : U32), 8191)
  Fe{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15, m16, m17, m18, m19}

# A canonical plain value as 32 big-endian bytes.
def canon_bytes(x: Fe) -> List<&2, U32>:
  match x:
    case Fe{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15, +x16, +x17, +x18, +x19}:
      +o0 = U32.and((x0 * 1 : U32), 255)
      +o1 = U32.and(((x0 / 256 : U32) + (x1 * 32 : U32) : U32), 255)
      +o2 = U32.and((x1 / 8 : U32), 255)
      +o3 = U32.and(((x1 / 2048 : U32) + (x2 * 4 : U32) : U32), 255)
      +o4 = U32.and(((x2 / 64 : U32) + (x3 * 128 : U32) : U32), 255)
      +o5 = U32.and((x3 / 2 : U32), 255)
      +o6 = U32.and(((x3 / 512 : U32) + (x4 * 16 : U32) : U32), 255)
      +o7 = U32.and((x4 / 16 : U32), 255)
      +o8 = U32.and(((x4 / 4096 : U32) + (x5 * 2 : U32) : U32), 255)
      +o9 = U32.and(((x5 / 128 : U32) + (x6 * 64 : U32) : U32), 255)
      +o10 = U32.and((x6 / 4 : U32), 255)
      +o11 = U32.and(((x6 / 1024 : U32) + (x7 * 8 : U32) : U32), 255)
      +o12 = U32.and((x7 / 32 : U32), 255)
      +o13 = U32.and((x8 * 1 : U32), 255)
      +o14 = U32.and(((x8 / 256 : U32) + (x9 * 32 : U32) : U32), 255)
      +o15 = U32.and((x9 / 8 : U32), 255)
      +o16 = U32.and(((x9 / 2048 : U32) + (x10 * 4 : U32) : U32), 255)
      +o17 = U32.and(((x10 / 64 : U32) + (x11 * 128 : U32) : U32), 255)
      +o18 = U32.and((x11 / 2 : U32), 255)
      +o19 = U32.and(((x11 / 512 : U32) + (x12 * 16 : U32) : U32), 255)
      +o20 = U32.and((x12 / 16 : U32), 255)
      +o21 = U32.and(((x12 / 4096 : U32) + (x13 * 2 : U32) : U32), 255)
      +o22 = U32.and(((x13 / 128 : U32) + (x14 * 64 : U32) : U32), 255)
      +o23 = U32.and((x14 / 4 : U32), 255)
      +o24 = U32.and(((x14 / 1024 : U32) + (x15 * 8 : U32) : U32), 255)
      +o25 = U32.and((x15 / 32 : U32), 255)
      +o26 = U32.and((x16 * 1 : U32), 255)
      +o27 = U32.and(((x16 / 256 : U32) + (x17 * 32 : U32) : U32), 255)
      +o28 = U32.and((x17 / 8 : U32), 255)
      +o29 = U32.and(((x17 / 2048 : U32) + (x18 * 4 : U32) : U32), 255)
      +o30 = U32.and(((x18 / 64 : U32) + (x19 * 128 : U32) : U32), 255)
      +o31 = U32.and((x19 / 2 : U32), 255)
      [o31, o30, o29, o28, o27, o26, o25, o24, o23, o22, o21, o20, o19, o18, o17, o16, o15, o14, o13, o12, o11, o10, o9, o8, o7, o6, o5, o4, o3, o2, o1, o0]

# A Montgomery-form value as its canonical big-endian bytes.
def to_bytes(+x: Fe) -> List<&2, U32>:
  canon_bytes(from_mont(x))

def pow_step(b: Bool, +x: Fe, a: Fe) -> Fe:
  match b:
    case True{}:
      mul(a, x)
    case False{}:
      a

def pow_go(+x: Fe, bits: List<&2, Bool>, acc: Fe) -> Fe:
  match bits:
    case Nil{}:
      acc
    case Con{b, t}:
      pow_go(x, t, pow_step(b, x, sq(acc)))

# The bits of p - 2, top first (a public exponent: branching on it leaks nothing).
def inv_bits() -> List<&2, Bool>:
  [True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, True{}, False{}, True{}]

# x^-1 = x^(p-2) (Fermat), in Montgomery form; 0 for 0.
def inv(+x: Fe) -> Fe:
  pow_go(x, inv_bits(), one())
