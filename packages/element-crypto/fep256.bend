          +w7 = (1 - (y7 / 8192 : U32) : U32)
          +y8 = (((a8 + 8192 : U32) - b8 : U32) - w7 : U32)
          +w8 = (1 - (y8 / 8192 : U32) : U32)
          +y9 = (((a9 + 8192 : U32) - b9 : U32) - w8 : U32)
          +w9 = (1 - (y9 / 8192 : U32) : U32)
          +y10 = (((a10 + 8192 : U32) - b10 : U32) - w9 : U32)
