          +y14 = (((a14 + 8192 : U32) - b14 : U32) - w13 : U32)
          +w14 = (1 - (y14 / 8192 : U32) : U32)
          +y15 = (((a15 + 8192 : U32) - b15 : U32) - w14 : U32)
          +w15 = (1 - (y15 / 8192 : U32) : U32)
          +y16 = (((a16 + 8192 : U32) - b16 : U32) - w15 : U32)
          +w16 = (1 - (y16 / 8192 : U32) : U32)
          +y17 = (((a17 + 8192 : U32) - b17 : U32) - w16 : U32)
