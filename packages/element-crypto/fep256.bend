      +y17 = (((x17 + 8192 : U32) - 8184 : U32) - w16 : U32)
      +w17 = (1 - (y17 / 8192 : U32) : U32)
      +y18 = (((x18 + 8192 : U32) - 8191 : U32) - w17 : U32)
