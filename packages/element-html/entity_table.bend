def at51(n: Nat) -> List<&2, U32>:
  match n:
    case 0n:
      b51()
    case 1n+r:
      Nil{}

def at50(n: Nat) -> List<&2, U32>:
  match n:
    case 0n:
      b50()
    case 1n+r:
      at51(r)

